{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://app.eximps-cloves.com/api/:path*"
        },
        {
            "source": "/blog",
            "destination": "https://blogeximp.vercel.app/blog"
        },
        {
            "source": "/blog/:path*",
            "destination": "https://blogeximp.vercel.app/blog/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}